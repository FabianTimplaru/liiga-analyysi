@baseUrl = http://localhost:3000

### Get all matches
GET {{baseUrl}}/api/matches 

### Get match by ID
GET {{baseUrl}}/api/matches/4

### HTTP Error 404
GET {{baseUrl}}/api/matches/1000

### HTTP Error 400
GET {{baseUrl}}/api/matches/abc

### Get all teams
GET {{baseUrl}}/api/teams

### Get wins by team in descending order
GET {{baseUrl}}/api/stats/wins

### Get team standings
GET {{baseUrl}}/api/stats/standings

### Get attendance stats
GET {{baseUrl}}/api/stats/attendance

### Get referee stats
GET {{baseUrl}}/api/stats/referees